{
    "name": "mvdnbrk/gtin",
    "description": "GTIN / EAN / UPC Validation for Laravel",
    "keywords": [
        "laravel",
        "validation",
        "validator",
        "ean",
        "upc",
        "gtin",
        "gs1"
    ],
    "homepage": "https://github.com/mvdnbrk/gtin",
    "license": "MIT",
    "authors": [
        {
            "name": "Mark van den Broek",
            "email": "mvdnbrk@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.x-dev"
        },
        "laravel": {
            "providers": [
                "Mvdnbrk\\Gtin\\GtinServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Mvdnbrk\\Gtin\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Mvdnbrk\\Gtin\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
